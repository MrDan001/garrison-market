{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "buildCommand": "cd apps/frontend && npm install && npm run build"
    },
    "deploy": {
      "startCommand": "cd apps/frontend && npm start",
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }