generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int         @id @default(autoincrement())
  email              String      @unique
  password           String
  role               String      @default("owner")
  status             String      @default("pending")
  fullName           String?
  phoneNumber        String?
  image              String?
  storeName          String?     // Kept for backward compatibility
  mustChangePassword Boolean     @default(false)
  createdAt          DateTime    @default(now())
  ownerId            Int?

  // ── Shop profile details (collected at registration, reviewed by admin) ──
  shopAddress        String?
  shopCity           String?
  shopState          String?
  productsSold       String?

  // ── Multi-Store Relationship ──
  stores             Store[]     @relation("OwnerStores")

  inventory          Inventory[]
  orders             Order[]
  staffOrders        Order[]     @relation("StaffOrders")
  reports            Report[]
  owner              User?       @relation("StaffHierarchy", fields: [ownerId], references: [id])
  managedStaff       User[]      @relation("StaffHierarchy")
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String?
  createdAt   DateTime @default(now())
  ownerId     Int
  owner       User     @relation("OwnerStores", fields: [ownerId], references: [id])
}

model Report {
  id       Int      @id @default(autoincrement())
  content  String
  status   String   @default("pending")
  date     DateTime @default(now())
  authorId Int
  ownerId  Int
  author   User     @relation(fields: [authorId], references: [id])
}

model Inventory {
  id           Int         @id @default(autoincrement())
  name         String
  quantity     Int
  price        Decimal
  costPrice    Decimal?
  category     String?
  restockLevel Int?
  image        String?
  updatedAt    DateTime    @updatedAt
  ownerId      Int
  owner        User        @relation(fields: [ownerId], references: [id])
  orderItems   OrderItem[]
}

model Order {
  id      Int         @id @default(autoincrement())
  total   Decimal
  date    DateTime    @default(now())
  ownerId Int
  staffId Int?
  owner   User        @relation(fields: [ownerId], references: [id])
  staff   User?       @relation("StaffOrders", fields: [staffId], references: [id])
  items   OrderItem[]
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  inventoryId Int
  quantity    Int
  priceAtTime Decimal
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])
}
