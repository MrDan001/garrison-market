generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  role               String   @default("owner")
  status             String   @default("pending")
  fullName           String?
  phoneNumber        String?
  storeName          String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Staff Management Relation
  managedStaff User[] @relation("StaffHierarchy")
  ownerId      Int?
  owner        User?  @relation("StaffHierarchy", fields: [ownerId], references: [id])

  reports   Report[]
  inventory Inventory[]
  orders    Order[]

  // --- ADD THIS LINE ---
  staffOrders Order[] @relation("StaffOrders")
}

model Report {
  id        Int      @id @default(autoincrement())
  content   String
  status    String   @default("pending") // Make sure this line exists
  date      DateTime @default(now())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  ownerId   Int
}

model Inventory {
  id         Int         @id @default(autoincrement())
  name       String
  quantity   Int
  price      Decimal
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  ownerId    Int
  owner      User        @relation(fields: [ownerId], references: [id])
}

model Order {
  id      Int         @id @default(autoincrement())
  total   Decimal
  date    DateTime    @default(now())
  items   OrderItem[]
  ownerId Int
  owner   User        @relation(fields: [ownerId], references: [id])

  staffId Int? // Add this line
  staff   User? @relation("StaffOrders", fields: [staffId], references: [id]) // Add this line
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id])
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  quantity    Int
  priceAtTime Decimal
}
