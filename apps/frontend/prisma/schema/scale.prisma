model ScaleInventory {
  id               Int                    @id @default(autoincrement())
  name             String
  quantity         Decimal
  unit             String
  price            Decimal
  costPrice        Decimal?
  category         String?
  restockLevel     Decimal?
  image            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  ownerId          Int
  storeId          Int?
  barcode          String?
  categoryId       Int?
  description      String?
  expiryDate       DateTime?
  image2           String?
  image3           String?
  sku              String?
  trackExpiry      Boolean                @default(false)
  consignmentItems ScaleConsignmentItem[]
  categoryRef      ProductCategory?       @relation(fields: [categoryId], references: [id])
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  store            Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems       ScaleOrderItem[]
  reportItems      ScaleReportItem[]
  stockBatches     ScaleStockBatch[]
  stockLosses      ScaleStockLoss[]
  stockReturns     ScaleStockReturn[]
  wastageEntries   ScaleWastage[]

  @@index([ownerId, storeId])
  @@index([storeId])
  @@index([categoryId])
}

model ScaleOrderItem {
  id                 Int                   @id @default(autoincrement())
  orderId            Int
  scaleInventoryId   Int
  quantity           Decimal
  unit               String
  quantityInBaseUnit Decimal
  priceAtTime        Decimal
  originalPrice      Decimal?
  discountValue      Decimal?
  discountType       String?
  discountReason     String?
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scaleInventory     ScaleInventory        @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  batchLines         ScaleOrderItemBatch[]

  @@index([orderId])
  @@index([scaleInventoryId])
}

model ScaleReportItem {
  id               Int            @id @default(autoincrement())
  reportId         Int
  scaleInventoryId Int
  name             String
  quantitySold     Decimal
  unit             String
  totalPrice       Decimal
  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  scaleInventory   ScaleInventory @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([scaleInventoryId])
}

model ScaleConsignmentItem {
  id               Int                         @id @default(autoincrement())
  consignmentId    Int
  scaleInventoryId Int
  quantityOut      Decimal
  quantitySold     Decimal                     @default(0)
  quantityReturned Decimal                     @default(0)
  unit             String
  priceAtTime      Decimal
  quantityWasted   Decimal                     @default(0)
  consignment      Consignment                 @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  scaleInventory   ScaleInventory              @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  batchAllocations ScaleConsignmentItemBatch[]
  wastageEntries   ScaleWastage[]

  @@index([consignmentId])
  @@index([scaleInventoryId])
}

model ScaleWastage {
  id                 Int                   @id @default(autoincrement())
  ownerId            Int
  storeId            Int
  scaleInventoryId   Int
  staffId            Int
  quantity           Decimal
  unit               String
  quantityInBaseUnit Decimal
  reason             String
  note               String?
  status             String                @default("pending")
  declineReason      String?
  reviewedById       Int?
  reviewedAt         DateTime?
  createdAt          DateTime              @default(now())
  consignmentItemId  Int?
  consignmentItem    ScaleConsignmentItem? @relation(fields: [consignmentItemId], references: [id])
  owner              User                  @relation("ScaleWastageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy         User?                 @relation("ScaleWastageReviewer", fields: [reviewedById], references: [id])
  scaleInventory     ScaleInventory        @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  staff              User                  @relation("ScaleWastageStaff", fields: [staffId], references: [id], onDelete: Cascade)
  store              Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([staffId])
}

model ScaleStockBatch {
  id                     Int                         @id @default(autoincrement())
  scaleInventoryId       Int
  ownerId                Int
  storeId                Int?
  originalQty            Decimal
  remainingQty           Decimal
  costPrice              Decimal?
  sellingPriceAtTime     Decimal
  expiryDate             DateTime?
  paymentMethod          String?
  addedAt                DateTime                    @default(now())
  createdById            Int?
  consignmentAllocations ScaleConsignmentItemBatch[]
  orderLines             ScaleOrderItemBatch[]
  createdBy              User?                       @relation("ScaleStockBatchCreatedBy", fields: [createdById], references: [id])
  owner                  User                        @relation("ScaleStockBatchOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  scaleInventory         ScaleInventory              @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  store                  Store?                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  losses                 ScaleStockLoss[]
  returns                ScaleStockReturn[]

  @@index([scaleInventoryId])
  @@index([ownerId, storeId])
}

model ScaleConsignmentItemBatch {
  id                Int                  @id @default(autoincrement())
  consignmentItemId Int
  scaleStockBatchId Int
  quantity          Decimal
  remainingQty      Decimal
  consignmentItem   ScaleConsignmentItem @relation(fields: [consignmentItemId], references: [id], onDelete: Cascade)
  scaleStockBatch   ScaleStockBatch      @relation(fields: [scaleStockBatchId], references: [id], onDelete: Cascade)

  @@index([consignmentItemId])
  @@index([scaleStockBatchId])
}

model ScaleOrderItemBatch {
  id                Int             @id @default(autoincrement())
  scaleOrderItemId  Int
  scaleStockBatchId Int
  quantity          Decimal
  scaleOrderItem    ScaleOrderItem  @relation(fields: [scaleOrderItemId], references: [id], onDelete: Cascade)
  scaleStockBatch   ScaleStockBatch @relation(fields: [scaleStockBatchId], references: [id], onDelete: Cascade)

  @@index([scaleOrderItemId])
  @@index([scaleStockBatchId])
}

model ScaleStockLoss {
  id                Int             @id @default(autoincrement())
  scaleInventoryId  Int
  scaleStockBatchId Int
  ownerId           Int
  storeId           Int?
  quantity          Decimal
  reason            String
  note              String?
  createdAt         DateTime        @default(now())
  recordedById      Int?
  owner             User            @relation("ScaleStockLossOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recordedBy        User?           @relation("ScaleStockLossRecordedBy", fields: [recordedById], references: [id])
  scaleInventory    ScaleInventory  @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  scaleStockBatch   ScaleStockBatch @relation(fields: [scaleStockBatchId], references: [id], onDelete: Cascade)
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([scaleInventoryId])
  @@index([scaleStockBatchId])
  @@index([ownerId, storeId])
}

model ScaleStockReturn {
  id                Int             @id @default(autoincrement())
  scaleInventoryId  Int
  scaleStockBatchId Int
  ownerId           Int
  storeId           Int?
  quantity          Decimal
  supplierName      String?
  reason            String?
  refundAmount      Decimal?
  note              String?
  createdAt         DateTime        @default(now())
  recordedById      Int?
  owner             User            @relation("ScaleStockReturnOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recordedBy        User?           @relation("ScaleStockReturnRecordedBy", fields: [recordedById], references: [id])
  scaleInventory    ScaleInventory  @relation(fields: [scaleInventoryId], references: [id], onDelete: Cascade)
  scaleStockBatch   ScaleStockBatch @relation(fields: [scaleStockBatchId], references: [id], onDelete: Cascade)
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([scaleInventoryId])
  @@index([scaleStockBatchId])
  @@index([ownerId, storeId])
}
