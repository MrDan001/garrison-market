generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          Int                  @id @default(autoincrement())
  email                       String               @unique
  password                    String
  role                        String               @default("owner")
  status                      String               @default("pending")
  fullName                    String?
  phoneNumber                 String?
  storeName                   String?
  mustChangePassword          Boolean              @default(false)
  createdAt                   DateTime             @default(now())
  ownerId                     Int?
  image                       String?
  productsSold                String?
  shopAddress                 String?
  shopCity                    String?
  shopState                   String?
  notificationsEnabled        Boolean              @default(true)
  discountEnabled             Boolean              @default(false)
  consignmentEnabled          Boolean              @default(false)
  staffStoreId                Int?
  currentPeriodEnd            DateTime?
  currentStoreId              Int?
  paystackAuthorizationCode   String?
  paystackCustomerCode        String?
  plan                        String               @default("basic")
  resetToken                  String?              @unique
  resetTokenExpiry            DateTime?
  subscriptionStatus          String               @default("trialing")
  trialEndsAt                 DateTime?
  hasTriggeredReferralReward  Boolean              @default(false)
  referralCode                String?              @unique
  referredById                Int?
  screenshotProtectionEnabled Boolean              @default(false)
  customPriceSetBy            String?
  customPriceUpdatedAt        DateTime?
  customPriceBasicNaira       Int?
  customPriceBasicNote        String?
  customPricePremiumNaira     Int?
  customPricePremiumNote      String?
  wastageVisibleToStaff       Boolean              @default(false)
  scaleConsignmentEnabled     Boolean              @default(false)
  customPriceMaxNaira         Int?
  customPriceMaxNote          String?
  maxPackageEnabled           Boolean              @default(false)
  mergedCartEnabled           Boolean              @default(false)
  customerProfilesOverride    Boolean              @default(false)
  debtorsOverride             Boolean              @default(false)
  ownerConsignmentOverride    Boolean              @default(false)
  staffConsignmentOverride    Boolean              @default(false)
  affiliateId                 Int?
  affiliateReferredAt         DateTime?
  currentSessionToken         String?
  lastActivityAt              DateTime?
  sentAdminBroadcasts         AdminBroadcast[]     @relation("AdminBroadcastSender")
  sentAdminMessages           AdminMessage[]       @relation("AdminMessageSender")
  targetedAdminMessages       AdminMessage[]       @relation("AdminMessageTarget")
  targetedStaffAdminMessages  AdminMessage[]       @relation("AdminMessageTargetStaff")
  adminMessageAcks            AdminMessageAck[]
  adminMessageReads           AdminMessageRead[]
  adminMessageReplies         AdminMessageReply[]  @relation("AdminMessageReplyOwner")
  consignmentsOwned           Consignment[]        @relation("OwnerConsignments")
  consignmentsStaffed         Consignment[]        @relation("StaffConsignments")
  customers                   Customer[]           @relation("OwnerCustomers")
  debtsOwned                  Debt[]               @relation("OwnerDebts")
  debtPaymentsMade            DebtPayment[]        @relation("StaffDebtPayments")
  devAssistantProject         DevAssistantProject? @relation("DevAssistantProjectAdmin")
  devAssistantThread          DevAssistantThread?  @relation("DevAssistantThreadAdmin")
  expensesLogged              Expense[]            @relation("ExpenseLoggedBy")
  expensesOwned               Expense[]            @relation("ExpenseOwner")
  expenseCategoriesOwned      ExpenseCategory[]    @relation("ExpenseCategoryOwner")
  inventory                   Inventory[]
  ownerNotifications          Notification[]       @relation("OwnerNotifications")
  recipientNotifications      Notification[]       @relation("RecipientNotifications")
  notificationReads           NotificationRead[]
  orders                      Order[]
  staffOrders                 Order[]              @relation("StaffOrders")
  payments                    Payment[]            @relation("OwnerPayments")
  planExtensions              PlanExtension[]      @relation("OwnerPlanExtensions")
  productCategoriesOwned      ProductCategory[]    @relation("ProductCategoryOwner")
  pushSubscriptions           PushSubscription[]
  reports                     Report[]
  scaleInventory              ScaleInventory[]
  scaleStockBatchesCreated    ScaleStockBatch[]    @relation("ScaleStockBatchCreatedBy")
  scaleStockBatchesOwned      ScaleStockBatch[]    @relation("ScaleStockBatchOwner")
  scaleStockLossesOwned       ScaleStockLoss[]     @relation("ScaleStockLossOwner")
  scaleStockLossesRecorded    ScaleStockLoss[]     @relation("ScaleStockLossRecordedBy")
  scaleStockReturnsOwned      ScaleStockReturn[]   @relation("ScaleStockReturnOwner")
  scaleStockReturnsRecorded   ScaleStockReturn[]   @relation("ScaleStockReturnRecordedBy")
  scaleWastageOwned           ScaleWastage[]       @relation("ScaleWastageOwner")
  scaleWastageReviewed        ScaleWastage[]       @relation("ScaleWastageReviewer")
  scaleWastageSubmitted       ScaleWastage[]       @relation("ScaleWastageStaff")
  stockBatchesCreated         StockBatch[]         @relation("StockBatchCreatedBy")
  stockBatchesOwned           StockBatch[]         @relation("StockBatchOwner")
  stockLossesOwned            StockLoss[]          @relation("StockLossOwner")
  stockLossesRecorded         StockLoss[]          @relation("StockLossRecordedBy")
  stockReturnsOwned           StockReturn[]        @relation("StockReturnOwner")
  stockReturnsRecorded        StockReturn[]        @relation("StockReturnRecordedBy")
  stores                      Store[]              @relation("OwnerStores")
  supportOwnerScope           SupportMessage[]     @relation("SupportOwnerScope")
  supportSent                 SupportMessage[]     @relation("SupportSender")
  referredByAffiliate         Affiliate?           @relation("AffiliateReferrals", fields: [affiliateId], references: [id])
  owner                       User?                @relation("StaffHierarchy", fields: [ownerId], references: [id], onDelete: Cascade)
  managedStaff                User[]               @relation("StaffHierarchy")
  referredBy                  User?                @relation("ReferralTree", fields: [referredById], references: [id])
  referrals                   User[]               @relation("ReferralTree")
  staffStore                  Store?               @relation("StoreStaff", fields: [staffStoreId], references: [id])

  @@index([ownerId])
  @@index([staffStoreId])
  @@index([role, status])
  @@index([referredById])
}

model Store {
  id                Int                @id @default(autoincrement())
  name              String
  phoneNumber       String?
  createdAt         DateTime           @default(now())
  ownerId           Int
  address           String?
  city              String?
  productsSold      String?
  state             String?
  storeType         String             @default("standard")
  shiftStartTime    String             @default("08:00")
  consignments      Consignment[]
  customers         Customer[]
  expenses          Expense[]
  inventory         Inventory[]
  notifications     Notification[]
  orders            Order[]
  reports           Report[]
  scaleInventory    ScaleInventory[]
  scaleStockBatches ScaleStockBatch[]
  scaleStockLosses  ScaleStockLoss[]
  scaleStockReturns ScaleStockReturn[]
  scaleWastage      ScaleWastage[]
  stockBatches      StockBatch[]
  stockLosses       StockLoss[]
  stockReturns      StockReturn[]
  owner             User               @relation("OwnerStores", fields: [ownerId], references: [id], onDelete: Cascade)
  staff             User[]             @relation("StoreStaff")

  @@index([ownerId])
}

model Report {
  id            Int               @id @default(autoincrement())
  status        String            @default("pending")
  date          DateTime          @default(now())
  authorId      Int
  ownerId       Int
  notes         String
  totalSales    Decimal
  storeId       Int?
  cashTotal     Decimal           @default(0)
  ownerNote     String?
  transferTotal Decimal           @default(0)
  author        User              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  store         Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         ReportItem[]
  scaleItems    ScaleReportItem[]

  @@index([ownerId, status])
  @@index([storeId])
  @@index([authorId])
  @@index([date])
}

model ReportItem {
  id             Int       @id @default(autoincrement())
  reportId       Int
  inventoryId    Int
  name           String
  quantity       Int
  price          Decimal
  total          Decimal
  originalPrice  Decimal?
  discountValue  Decimal?
  discountType   String?
  discountReason String?
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([inventoryId])
}

model Inventory {
  id               Int               @id @default(autoincrement())
  name             String
  quantity         Int
  price            Decimal
  updatedAt        DateTime          @updatedAt
  ownerId          Int
  category         String?
  costPrice        Decimal?
  image            String?
  restockLevel     Int?
  createdAt        DateTime          @default(now())
  storeId          Int?
  barcode          String?
  categoryId       Int?
  description      String?
  expiryDate       DateTime?
  image2           String?
  image3           String?
  sku              String?
  trackExpiry      Boolean           @default(false)
  consignmentItems ConsignmentItem[]
  categoryRef      ProductCategory?  @relation(fields: [categoryId], references: [id])
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  store            Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  reportItems      ReportItem[]
  stockBatches     StockBatch[]
  stockLosses      StockLoss[]
  stockReturns     StockReturn[]

  @@index([ownerId, storeId])
  @@index([storeId])
  @@index([categoryId])
}

model StockBatch {
  id                 Int              @id @default(autoincrement())
  inventoryId        Int
  ownerId            Int
  storeId            Int?
  originalQty        Int
  remainingQty       Int
  costPrice          Decimal?
  sellingPriceAtTime Decimal
  expiryDate         DateTime?
  paymentMethod      String?
  addedAt            DateTime         @default(now())
  createdById        Int?
  orderLines         OrderItemBatch[]
  createdBy          User?            @relation("StockBatchCreatedBy", fields: [createdById], references: [id])
  inventory          Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  owner              User             @relation("StockBatchOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  store              Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  losses             StockLoss[]
  returns            StockReturn[]

  @@index([inventoryId])
  @@index([ownerId, storeId])
}

model StockLoss {
  id           Int        @id @default(autoincrement())
  inventoryId  Int
  stockBatchId Int
  ownerId      Int
  storeId      Int?
  quantity     Int
  reason       String
  note         String?
  createdAt    DateTime   @default(now())
  recordedById Int?
  inventory    Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  owner        User       @relation("StockLossOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recordedBy   User?      @relation("StockLossRecordedBy", fields: [recordedById], references: [id])
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Cascade)
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([ownerId, storeId])
}

model StockReturn {
  id           Int        @id @default(autoincrement())
  inventoryId  Int
  stockBatchId Int
  ownerId      Int
  storeId      Int?
  quantity     Int
  supplierName String?
  reason       String?
  refundAmount Decimal?
  note         String?
  createdAt    DateTime   @default(now())
  recordedById Int?
  inventory    Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  owner        User       @relation("StockReturnOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recordedBy   User?      @relation("StockReturnRecordedBy", fields: [recordedById], references: [id])
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Cascade)
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([ownerId, storeId])
}

model Order {
  id            Int              @id @default(autoincrement())
  total         Decimal
  date          DateTime         @default(now())
  ownerId       Int
  staffId       Int?
  consignmentId Int?
  storeId       Int?
  paymentMethod String           @default("cash")
  buyerName     String?
  buyerPhone    String?
  customerId    Int?
  debt          Debt?
  consignment   Consignment?     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  customer      Customer?        @relation(fields: [customerId], references: [id])
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff         User?            @relation("StaffOrders", fields: [staffId], references: [id])
  store         Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  scaleItems    ScaleOrderItem[]

  @@index([ownerId, date])
  @@index([storeId, date])
  @@index([staffId, date])
  @@index([customerId, date])
}

model OrderItem {
  id             Int              @id @default(autoincrement())
  orderId        Int
  inventoryId    Int
  quantity       Int
  priceAtTime    Decimal
  discountReason String?
  discountType   String?
  discountValue  Decimal?
  originalPrice  Decimal?
  inventory      Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchLines     OrderItemBatch[]

  @@index([orderId])
  @@index([inventoryId])
}

model OrderItemBatch {
  id           Int        @id @default(autoincrement())
  orderItemId  Int
  stockBatchId Int
  quantity     Int
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([stockBatchId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  ownerId   Int
  storeId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("OwnerCustomers", fields: [ownerId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  debts     Debt[]
  orders    Order[]

  @@unique([storeId, phone])
  @@index([ownerId])
  @@index([storeId, name])
}

model Notification {
  id          Int                @id @default(autoincrement())
  type        String
  message     String
  link        String?
  read        Boolean            @default(false)
  ownerId     Int
  recipientId Int?
  createdAt   DateTime           @default(now())
  storeId     Int?
  owner       User               @relation("OwnerNotifications", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient   User?              @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  store       Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reads       NotificationRead[]

  @@index([ownerId, read])
  @@index([recipientId, read])
  @@index([createdAt])
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminNotification {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model AdminBroadcast {
  id             Int      @id @default(autoincrement())
  title          String
  body           String
  link           String?
  targetType     String
  targetId       Int?
  recipientCount Int      @default(0)
  sentById       Int
  createdAt      DateTime @default(now())
  sentBy         User     @relation("AdminBroadcastSender", fields: [sentById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sentById])
}

model Consignment {
  id             Int                    @id @default(autoincrement())
  ownerId        Int
  staffId        Int?
  recipientName  String
  recipientPhone String
  recipientNote  String?
  status         String                 @default("out")
  createdAt      DateTime               @default(now())
  settledAt      DateTime?
  storeId        Int?
  owner          User                   @relation("OwnerConsignments", fields: [ownerId], references: [id], onDelete: Cascade)
  staff          User?                  @relation("StaffConsignments", fields: [staffId], references: [id])
  store          Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          ConsignmentItem[]
  orders         Order[]
  scaleItems     ScaleConsignmentItem[]

  @@index([ownerId])
  @@index([staffId])
  @@index([storeId])
  @@index([status])
}

model ConsignmentItem {
  id               Int         @id @default(autoincrement())
  consignmentId    Int
  inventoryId      Int
  quantityOut      Int
  quantitySold     Int         @default(0)
  quantityReturned Int         @default(0)
  priceAtTime      Decimal
  consignment      Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  inventory        Inventory   @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([consignmentId])
  @@index([inventoryId])
}

model Debt {
  id          Int           @id @default(autoincrement())
  orderId     Int           @unique
  customerId  Int
  ownerId     Int
  storeId     Int?
  totalAmount Decimal
  amountPaid  Decimal       @default(0)
  status      String        @default("owing")
  createdAt   DateTime      @default(now())
  settledAt   DateTime?
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  owner       User          @relation("OwnerDebts", fields: [ownerId], references: [id], onDelete: Cascade)
  payments    DebtPayment[]

  @@index([ownerId])
  @@index([customerId])
  @@index([storeId])
  @@index([status])
}

model DebtPayment {
  id               Int      @id @default(autoincrement())
  debtId           Int
  amount           Decimal
  staffId          Int?
  createdAt        DateTime @default(now())
  isInitialPayment Boolean  @default(false)
  paymentMethod    String   @default("cash")
  debt             Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  staff            User?    @relation("StaffDebtPayments", fields: [staffId], references: [id])

  @@index([debtId])
  @@index([staffId])
}

model ProductCategory {
  id                  Int              @id @default(autoincrement())
  ownerId             Int
  name                String
  createdAt           DateTime         @default(now())
  inventoryItems      Inventory[]
  owner               User             @relation("ProductCategoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  scaleInventoryItems ScaleInventory[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  name      String
  createdAt DateTime  @default(now())
  expenses  Expense[]
  owner     User      @relation("ExpenseCategoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Expense {
  id         Int              @id @default(autoincrement())
  ownerId    Int
  storeId    Int?
  categoryId Int?
  amount     Decimal
  note       String?
  loggedById Int?
  createdAt  DateTime         @default(now())
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  loggedBy   User?            @relation("ExpenseLoggedBy", fields: [loggedById], references: [id])
  owner      User             @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  store      Store?           @relation(fields: [storeId], references: [id])

  @@index([ownerId, storeId, createdAt])
  @@index([categoryId])
  @@index([loggedById])
}

model SupportMessage {
  id              Int      @id @default(autoincrement())
  threadType      String
  ownerId         Int
  staffId         Int?
  senderId        Int
  senderRole      String
  content         String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())
  isIntakeSummary Boolean  @default(false)
  owner           User     @relation("SupportOwnerScope", fields: [ownerId], references: [id], onDelete: Cascade)
  sender          User     @relation("SupportSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([senderId])
  @@index([threadType, ownerId])
}

model SupportIntake {
  id             Int       @id @default(autoincrement())
  threadType     String
  ownerId        Int
  staffId        Int?
  name           String
  storeName      String?
  email          String
  category       String
  urgency        String
  blockingSales  String?
  detailAnswer   String?
  triedSelfHelp  String?
  extraNotes     String?
  status         String    @default("open")
  resolvedBySelf Boolean   @default(false)
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
  adminRead      Boolean   @default(false)

  @@index([threadType, ownerId, status])
  @@index([threadType, staffId, status])
}

model AdminMessage {
  id            Int                 @id @default(autoincrement())
  subject       String
  body          String
  link          String?
  imageUrl      String?
  audience      String
  targetOwnerId Int?
  sentById      Int
  createdAt     DateTime            @default(now())
  targetStaffId Int?
  channel       String              @default("email")
  sentBy        User                @relation("AdminMessageSender", fields: [sentById], references: [id], onDelete: Cascade)
  targetOwner   User?               @relation("AdminMessageTarget", fields: [targetOwnerId], references: [id], onDelete: Cascade)
  targetStaff   User?               @relation("AdminMessageTargetStaff", fields: [targetStaffId], references: [id], onDelete: Cascade)
  acks          AdminMessageAck[]
  reads         AdminMessageRead[]
  replies       AdminMessageReply[]

  @@index([audience, targetOwnerId])
  @@index([audience, targetStaffId])
  @@index([createdAt])
}

model AdminMessageRead {
  id        Int          @id @default(autoincrement())
  messageId Int
  ownerId   Int
  readAt    DateTime     @default(now())
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([messageId, ownerId])
  @@index([ownerId])
}

model AdminMessageAck {
  id             Int          @id @default(autoincrement())
  messageId      Int
  userId         Int
  acknowledgedAt DateTime     @default(now())
  message        AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model AdminMessageReply {
  id         Int          @id @default(autoincrement())
  messageId  Int
  ownerId    Int
  authorRole String
  body       String
  createdAt  DateTime     @default(now())
  message    AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  owner      User         @relation("AdminMessageReplyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([messageId, ownerId])
  @@index([ownerId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  plan        String
  amount      Decimal
  reference   String   @unique
  status      String   @default("pending")
  periodStart DateTime @default(now())
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  owner       User     @relation("OwnerPayments", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model PlanExtension {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  days      Int
  reason    String?
  grantedBy String
  createdAt DateTime @default(now())
  owner     User     @relation("OwnerPlanExtensions", fields: [ownerId], references: [id], onDelete: Cascade)
}

model TypingStatus {
  id         Int      @id @default(autoincrement())
  threadKey  String
  senderRole String
  updatedAt  DateTime @updatedAt

  @@unique([threadKey, senderRole])
}

model AdminMessageThreadStatus {
  id        Int       @id @default(autoincrement())
  messageId Int
  ownerId   Int
  status    String    @default("open")
  closedAt  DateTime?
  closedBy  String?

  @@unique([messageId, ownerId])
  @@index([messageId])
  @@index([ownerId])
}

model RateLimitBucket {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
