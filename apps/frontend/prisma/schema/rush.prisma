model RushProfile {
  id                 Int             @id @default(autoincrement())
  userId             Int
  storeId            Int
  level              Int             @default(1)
  totalXp            Int             @default(0)
  xpIntoLevel        Int             @default(0)
  currentStreak      Int             @default(0)
  longestStreak      Int             @default(0)
  lastActiveDate     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  badges             Json?
  streakShieldActive Boolean         @default(false)
  questProgress      QuestProgress[]
  rewardSpins        RewardSpin[]
  xpEvents           XpEvent[]

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

model XpEvent {
  id            Int         @id @default(autoincrement())
  rushProfileId Int
  type          String
  amount        Int
  meta          Json?
  createdAt     DateTime    @default(now())
  rushProfile   RushProfile @relation(fields: [rushProfileId], references: [id], onDelete: Cascade)

  @@index([rushProfileId, createdAt])
  @@index([type])
}

model QuestProgress {
  id                   Int         @id @default(autoincrement())
  rushProfileId        Int
  type                 String
  questDate            DateTime
  progress             Int         @default(0)
  target               Int         @default(5)
  completed            Boolean     @default(false)
  completedAt          DateTime?
  verifiedInventoryIds Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  rushProfile          RushProfile @relation(fields: [rushProfileId], references: [id], onDelete: Cascade)

  @@unique([rushProfileId, type, questDate])
  @@index([rushProfileId])
}

model RewardSpin {
  id                 Int              @id @default(autoincrement())
  rushProfileId      Int
  spinDate           DateTime
  claimed            Boolean          @default(false)
  prizeLabel         String?
  claimedAt          DateTime?
  createdAt          DateTime         @default(now())
  prizeKind          String?
  prizeOptionId      Int?
  requiresSettlement Boolean          @default(false)
  settled            Boolean          @default(false)
  settledAt          DateTime?
  settledByOwnerId   Int?
  prizeOption        SpinPrizeOption? @relation(fields: [prizeOptionId], references: [id])
  rushProfile        RushProfile      @relation(fields: [rushProfileId], references: [id], onDelete: Cascade)

  @@unique([rushProfileId, spinDate])
  @@index([rushProfileId])
  @@index([prizeOptionId])
  @@index([requiresSettlement, settled])
}

model SpinPrizeOption {
  id              Int          @id @default(autoincrement())
  storeId         Int
  label           String
  kind            String
  xpAmount        Int?
  cashAmount      Int?
  giftDescription String?
  weight          Int          @default(1)
  active          Boolean      @default(true)
  isDefault       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  spins           RewardSpin[]

  @@index([storeId])
  @@index([storeId, active])
}

model ClockEvent {
  id         Int       @id @default(autoincrement())
  userId     Int
  storeId    Int
  clockDate  DateTime
  clockInAt  DateTime
  clockOutAt DateTime?
  onTime     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@unique([userId, storeId, clockDate])
  @@index([storeId, clockDate])
}
