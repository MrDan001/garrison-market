model WaitlistSignup {
  id                Int       @id @default(autoincrement())
  fullName          String
  email             String    @unique
  phone             String
  state             String?
  lga               String?
  sells             String?
  referralCode      String    @unique
  referredByCode    String?
  referredByType    String?
  referralBoost     Int       @default(0)
  status            String    @default("waiting")
  invitedAt         DateTime?
  registeredOwnerId Int?
  createdAt         DateTime  @default(now())
  biggestChallenge  String?
  toolFrustrations  String?
  wantToSee         String?

  @@index([referralCode])
  @@index([referredByCode])
  @@index([status])
  @@index([createdAt])
}
